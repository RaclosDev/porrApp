# Base de Datos
POSTGRES_DB=porra_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
# Clave JWT obligatoria en producción (mínimo 256 bits / 32 bytes):
# Linux/macOS: openssl rand -base64 32
# PowerShell 7: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=https://porra.raclos.es,http://localhost:5173,http://localhost:8080

# Docker Compose usa GOOGLE_CLIENT_ID también para compilar el frontend.
# Con npm run dev, define VITE_GOOGLE_CLIENT_ID en frontend/.env.local.
