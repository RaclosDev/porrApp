# Base de Datos
POSTGRES_DB=porra_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
# Clave JWT obligatoria en producción (mínimo 256 bits / 32 bytes):
# Linux/macOS: openssl rand -base64 32
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=https://porra.raclos.es,http://localhost:5173,http://localhost:8080

# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
